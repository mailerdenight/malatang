# This file is copied to:
# ~/Library/Application Support/MalatangLogCI/config.env
# Never commit the real config or the .p8 key.

REPO_PATH="__REPO_ROOT__"
PROJECT_PATH="MalatangLog.xcodeproj"
SCHEME="MalatangLog"
CONFIGURATION="Release"

REMOTE_NAME="origin"
BRANCH="main"

TEAM_ID="3U97PCNG99"
BUNDLE_ID="com.malatanglog.app"

# Upload every successfully archived commit to TestFlight.
AUTO_UPLOAD="true"
# true makes this build usable only by internal TestFlight testers.
TESTFLIGHT_INTERNAL_ONLY="true"

# App Store Connect > Users and Access > Integrations
ASC_KEY_ID="REPLACE_WITH_KEY_ID"
ASC_ISSUER_ID="REPLACE_WITH_ISSUER_ID"
ASC_KEY_PATH="__SUPPORT_DIR__/private_keys/AuthKey_REPLACE_WITH_KEY_ID.p8"

